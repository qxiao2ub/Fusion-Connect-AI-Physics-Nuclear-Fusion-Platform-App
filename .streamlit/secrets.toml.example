# Streamlit Community Cloud -> App -> Settings -> Secrets
# Do NOT commit real production secrets to GitHub.

ADMIN_PASSCODE = "replace-this-with-a-strong-private-password"

# Persistent cumulative app-user counter.
# Create a Supabase project and run persistence/app_visits.sql first.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY = "YOUR_SERVER_SIDE_SERVICE_ROLE_KEY"
